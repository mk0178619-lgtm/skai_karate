{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "skaikarate-kolathur.com" }
      ],
      "destination": "https://www.skaikarate-kolathur.com/%3A1",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/verify/:id", "destination": "/index.html" },
    { "source": "/print-certificate/:id", "destination": "/index.html" }
  ]
}
